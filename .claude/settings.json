{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "tutti agent-event claude",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "tutti agent-event claude",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "tutti agent-event claude",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "tutti agent-event claude",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "tutti agent-event claude",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}